{
  "name": "cinderx-community-site",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "scripts": {
    "docusaurus": "docusaurus",
    "start": "docusaurus start",
    "build": "docusaurus build",
    "serve": "docusaurus serve",
    "clear": "docusaurus clear",
    "typecheck": "tsc --noEmit",
    "spellcheck": "cspell \"docs/**/*.md\" \"docs/**/*.mdx\" \"blog/**/*.md\" --config ./.cspell.json",
    "lint": "tsc --noEmit && prettier --check \"**/*.{ts,tsx,js,jsx,md,mdx,css,json,yml,yaml}\" && cspell \"docs/**/*.md\" \"docs/**/*.mdx\" \"blog/**/*.md\" --config ./.cspell.json",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,md,mdx,css,json,yml,yaml}\""
  },
  "dependencies": {
    "@docusaurus/core": "3.9.2",
    "@docusaurus/preset-classic": "3.9.2",
    "@easyops-cn/docusaurus-search-local": "0.55.0",
    "clsx": "2.1.1",
    "prism-react-renderer": "2.4.1",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.9.2",
    "@docusaurus/plugin-content-docs": "3.9.2",
    "@docusaurus/tsconfig": "3.9.2",
    "@docusaurus/types": "3.9.2",
    "@types/node": "25.3.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "cspell": "^10.0.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.0"
  }
}
